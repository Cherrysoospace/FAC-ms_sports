PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin_sports
DB_PASS=cambia_esta_clave
DB_NAME=sports_db
MS_SECURITY=http://localhost:8181
CORS_ORIGINS=http://localhost:3000

# Correo:
# - console = se muestra en el log (por defecto);
# - security = delega el envío a ms_security (usa SECURITY_SERVICE_URL o MS_SECURITY por defecto; recomendado);
# - smtp = envío real directo con nodemailer.
MAIL_MODE=console
# SECURITY_SERVICE_URL=http://localhost:8181
# MAIL_TIMEOUT_MS=5000
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Script simulador de la pizarra (npm run simulate:positions -- <matchId>).
# Usuario de ms_security con el rol "SIMULADOR DE POSICIONES" (sin 2FA).
SIMULATOR_EMAIL=simulador@uc.edu.co
SIMULATOR_PASSWORD=

# Simulación AUTOMÁTICA de la pizarra (solo desarrollo/demo, HU-GC-09):
# con true, cada partido que pasa a "En curso" registra posiciones solo y se
# detiene cuando termina o se cancela. En producción debe quedar en false.
SIMULATE_POSITIONS=false
# SIMULATE_POSITIONS_INTERVAL_MS=1500
