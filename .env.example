PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin_sports
DB_PASS=cambia_esta_clave
DB_NAME=sports_db
MS_SECURITY=http://localhost:8181
CORS_ORIGINS=http://localhost:3000

# Correo (mismas variables que ms_security).
# console = se muestra en el log (por defecto); smtp = envío real con nodemailer.
MAIL_MODE=console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Script simulador de la pizarra (npm run simulate:positions -- <matchId>).
# Usuario de ms_security con el rol "SIMULADOR DE POSICIONES" (sin 2FA).
SIMULATOR_EMAIL=
SIMULATOR_PASSWORD=
